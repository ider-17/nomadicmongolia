  const handleSubmit = async () => {
    await fetch("/api/tours", {
      method: "POST",
      body: JSON.stringify({ title }),
    });
  };

  return (
    <div>
      <h1>Аялал нэмэх</h1>
      <input value={title} onChange={(e) => setTitle(e.target.value)} />
      <button onClick={handleSubmit}>Нэмэх</button>
    </div>
  );
}
